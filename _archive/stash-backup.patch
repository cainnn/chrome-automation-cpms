+    /// <summary>
+    /// 直接 POST CPMS 下载接口尝试下载文件。
+    /// </summary>
+    private static async Task<string?> TryDirectPostDownloadAsync(
+        string cookies, string serialNumber, string saveDir)
+    {
+        var origin = "http://cpms.hq.cmcc";
+        var endpoints = new[]
+        {
+            $"{origin}/cpms/file/fileserver/special/formDownloadByFileIds",
+            $"{origin}/pms/file/fileserver/special/formDownloadByFileIds",
+        };
+
+        var bodies = new (string body, string contentType)[]
+        {
+            ($"fileIds={serialNumber}", "application/x-www-form-urlencoded"),
+            ($"businessSerialNumber={serialNumber}", "application/x-www-form-urlencoded"),
+            ($"serialNumber={serialNumber}", "application/x-www-form-urlencoded"),
+            ($"attachmentId={serialNumber}", "application/x-www-form-urlencoded"),
+            (JsonSerializer.Serialize(new { fileIds = new[] { serialNumber } }), "application/json"),
+            (JsonSerializer.Serialize(new { businessSerialNumber = serialNumber }), "application/json"),
+            (JsonSerializer.Serialize(new { serialNumber }), "application/json"),
+        };
+
+        using var handler = new HttpClientHandler { AllowAutoRedirect = true };
+        using var client = new HttpClient(handler) { Timeout = TimeSpan.FromSeconds(60) };
+
+        foreach (var endpoint in endpoints)
+        {
+            foreach (var (body, ct) in bodies)
+            {
+                try
+                {
+                    var request = new HttpRequestMessage(HttpMethod.Post, endpoint)
+                    {
+                        Content = new StringContent(body, Encoding.UTF8, new MediaTypeHeaderValue(ct)),
+                    };
+                    request.Headers.Add("Cookie", cookies);
+                    request.Headers.Add("User-Agent", "Mozilla/5.0 (Windows NT 10.0; Win64; x64) Chrome/130.0.0.0");
+                    request.Headers.Referrer = new Uri($"{origin}/pms/");
+
+                    using var response = await client.SendAsync(request, HttpCompletionOption.ResponseHeadersRead);
+
+                    if (!response.IsSuccessStatusCode) continue;
+
+                    var contentType = response.Content.Headers.ContentType?.MediaType ?? "";
+                    // 跳过小 JSON/HTML 响应（错误页面）
+                    var contentLength = response.Content.Headers.ContentLength;
+                    if ((contentType.Contains("json") || contentType.Contains("html")) && (contentLength ?? 0) < 4096)
+                        continue;
+
+                    // 看起来像文件下载
+                    if (contentLength > 10000 || contentType.Contains("octet-stream") ||
+                        contentType.Contains("zip") || contentType.Contains("download"))
+                    {
+                        var filename = GetFilenameFromResponse(response, endpoint, serialNumber);
+                        var savePath = Path.Combine(saveDir, filename);
+                        Console.WriteLine($"[6/7] POST 命中: {endpoint} (body={body[..Math.Min(body.Length, 60)]}), Content-Type={contentType}, 大小={contentLength}");
+
+                        using var fs = new FileStream(savePath, FileMode.Create, FileAccess.Write, FileShare.None);
+                        await response.Content.CopyToAsync(fs);
+                        await fs.FlushAsync();
+
+                        var fi = new FileInfo(savePath);
+                        Console.WriteLine($"[6/7] 已保存: {savePath} ({fi.Length / 1024}KB)");
+
+                        if (fi.Length < 1024) { File.Delete(savePath); continue; }
+                        return savePath;
+                    }
+                }
+                catch { }
+            }
+        }
+
+        Console.WriteLine("[6/7] 所有 POST 组合均未返回文件");
+        return null;
+    }
+
+    private static string GetFilenameFromResponse(HttpResponseMessage response, string url, string serialHint)
+    {
+        // 优先从 Content-Disposition 获取
+        var cd = response.Content.Headers.ContentDisposition;
+        if (cd != null)
+        {
+            var fn = cd.FileNameStar ?? cd.FileName;
+            if (!string.IsNullOrEmpty(fn))
+            {
+                fn = fn.Trim('"').Trim('\'');
+                if (fn.Any(c => c > 127)) fn = Uri.UnescapeDataString(fn);
+                if (!string.IsNullOrEmpty(fn)) return fn;
+            }
+        }
+
+        // 从 URL 获取
+        var uri = new Uri(url);
+        var pathSegment = Uri.UnescapeDataString(uri.Segments.LastOrDefault("") ?? "");
+        if (!string.IsNullOrEmpty(pathSegment) && pathSegment.Contains('.'))
+            return pathSegment;
+
+        // 生成默认文件名
+        return $"项目明细查询-{serialHint}-{DateTime.Now:yyyyMMdd-HHmmss}.zip";
+    }
