+    /// <summary>
+    /// 直接调用 CPMS 下载 API 查询下载信息。
+    /// </summary>
+    private static async Task<(string? url, string? cookies)> QueryCpmsDownloadApiAsync(
+        string apiUrl, string serialNumber, string? cookies, string? origin)
+    {
+        using var handler = new HttpClientHandler { AllowAutoRedirect = true, UseCookies = false };
+        using var client = new HttpClient(handler) { Timeout = TimeSpan.FromSeconds(30) };
+
+        var bodies = new[]
+        {
+            $"businessSerialNumber={serialNumber}",
+            $"serialNumber={serialNumber}",
+            $"fileIds={serialNumber}",
+        };
+
+        foreach (var body in bodies)
+        {
+            var request = new HttpRequestMessage(HttpMethod.Post, apiUrl);
+            request.Headers.Add("Cookie", cookies ?? "");
+            if (!string.IsNullOrEmpty(origin))
+                request.Headers.Referrer = new Uri(origin);
+            request.Content = new StringContent(body, System.Text.Encoding.UTF8, "application/x-www-form-urlencoded");
+
+            using var response = await client.SendAsync(request);
+            if (!response.IsSuccessStatusCode) continue;
+
+            var json = await response.Content.ReadAsStringAsync();
+
+            // 从响应中提取下载 URL
+            var urlMatches = System.Text.RegularExpressions.Regex.Matches(json,
+                @"https?://[^\s""'\\]+?\.(zip|xlsx|xls|download)[^\s""'\\]*",
+                System.Text.RegularExpressions.RegexOptions.IgnoreCase);
+
+            foreach (System.Text.RegularExpressions.Match m in urlMatches)
+            {
+                return (m.Value, cookies);
+            }
+
+            // 也尝试 JSON 中的 downloadUrl / url 字段
+            using var doc = JsonDocument.Parse(json);
+            var downloadUrl = FindUrlInJson(doc.RootElement);
+            if (!string.IsNullOrEmpty(downloadUrl))
+                return (downloadUrl, cookies);
+        }
+
+        return (null, null);
+    }
