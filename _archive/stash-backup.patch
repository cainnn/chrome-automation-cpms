+    /// 使用 HttpClient 直接下载文件，绕过 Chrome 下载安全拦截。
+    /// </summary>
+    private static async Task<string?> DownloadWithHttpClientAsync(
+        string url, string cookies, string? origin, string downloadsDir, string? serialNumber)
+    {
+        try
+        {
+            using var handler = new HttpClientHandler
+            {
+                AllowAutoRedirect = true,
+                UseCookies = false,
+            };
+            using var client = new HttpClient(handler) { Timeout = TimeSpan.FromMinutes(5) };
+
+            var request = new HttpRequestMessage(HttpMethod.Get, url);
+            if (!string.IsNullOrEmpty(cookies))
+                request.Headers.Add("Cookie", cookies);
+            if (!string.IsNullOrEmpty(origin))
+                request.Headers.Referrer = new Uri(origin);
+            request.Headers.UserAgent.ParseAdd(
+                "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/137.0.0.0 Safari/537.36");
+
+            Console.WriteLine($"[6/7] HttpClient GET: {url}");
+            using var response = await client.SendAsync(request, HttpCompletionOption.ResponseHeadersRead);
+            Console.WriteLine($"[6/7] 响应: {(int)response.StatusCode} {response.StatusCode}, Content-Type: {response.Content.Headers.ContentType}");
+
+            if (!response.IsSuccessStatusCode)
+            {
+                Console.WriteLine($"[6/7] HTTP 错误: {response.StatusCode}");
+                return null;
+            }
+
+            // 从 Content-Disposition 或 URL 推断文件名
+            var filename = ExtractFilename(response, url, serialNumber);
+            var filePath = Path.Combine(downloadsDir, filename);
+
+            // 原子写入：先写临时文件再重命名
+            var tempPath = filePath + ".downloading";
+            try
+            {
+                using var stream = await response.Content.ReadAsStreamAsync();
+                using var fs = new FileStream(tempPath, FileMode.Create, FileAccess.Write, FileShare.None, 8192, FileOptions.Asynchronous);
+                var buffer = new byte[8192];
+                long totalRead = 0;
+                int read;
+                while ((read = await stream.ReadAsync(buffer, 0, buffer.Length)) > 0)
+                {
+                    await fs.WriteAsync(buffer, 0, read);
+                    totalRead += read;
+                    if (totalRead % (1024 * 1024) == 0) // 每MB输出一次进度
+                        Console.WriteLine($"[6/7] 已下载: {totalRead / (1024 * 1024)} MB");
+                }
+            }
+            catch (Exception ex)
+            {
+                Console.WriteLine($"[6/7] 下载中断: {ex.Message}");
+                try { File.Delete(tempPath); } catch { }
+                return null;
+            }
+
+            if (File.Exists(filePath))
+                File.Delete(filePath);
+            File.Move(tempPath, filePath);
+
+            var fi = new FileInfo(filePath);
+            Console.WriteLine($"[6/7] 文件已保存: {filePath} ({fi.Length / 1024} KB)");
+            return filePath;
+        }
+        catch (Exception ex)
+        {
+            Console.WriteLine($"[6/7] HttpClient 下载异常: {ex.Message}");
+            return null;
+        }
+    }
