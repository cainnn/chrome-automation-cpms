+    /// <summary>
+    /// 用 .NET HttpClient 直接下载文件（不走 Chrome 下载 UI）。
+    /// </summary>
+    private static async Task<string?> DownloadWithHttpClientAsync(
+        string url, string? cookies, string saveDir, string serialHint)
+    {
+        using var handler = new HttpClientHandler
+        {
+            AllowAutoRedirect = true,
+            AutomaticDecompression = System.Net.DecompressionMethods.GZip | System.Net.DecompressionMethods.Deflate,
+        };
+        using var client = new HttpClient(handler) { Timeout = TimeSpan.FromSeconds(120) };
+
+        var request = new HttpRequestMessage(HttpMethod.Get, url);
+        if (!string.IsNullOrEmpty(cookies))
+            request.Headers.Add("Cookie", cookies);
+        request.Headers.Add("User-Agent", "Mozilla/5.0 (Windows NT 10.0; Win64; x64) Chrome/130.0.0.0");
+
+        // CPMS 可能需要 Referer
+        if (url.Contains("cpms.hq.cmcc") || url.Contains("pms/"))
+            request.Headers.Referrer = new Uri("http://cpms.hq.cmcc/pms/");
+
+        Console.WriteLine("[6/7] 发送下载请求...");
+        using var response = await client.SendAsync(request, HttpCompletionOption.ResponseHeadersRead);
+        Console.WriteLine($"[6/7] 响应: {(int)response.StatusCode} {response.StatusCode}, Content-Type: {response.Content.Headers.ContentType}");
+
+        if (!response.IsSuccessStatusCode)
+            throw new HttpRequestException($"下载失败: {(int)response.StatusCode} {response.StatusCode}");
+
+        // 从响应头或 URL 推断文件名
+        var filename = GetFilenameFromResponse(response, url, serialHint);
+        var savePath = Path.Combine(saveDir, filename);
+
+        // 如果文件已存在，加序号
+        if (File.Exists(savePath))
+        {
+            var baseName = Path.GetFileNameWithoutExtension(filename);
+            var ext = Path.GetExtension(filename);
+            for (var i = 2; i < 100; i++)
+            {
+                savePath = Path.Combine(saveDir, $"{baseName} ({i}){ext}");
+                if (!File.Exists(savePath)) break;
+            }
+        }
+
+        Console.WriteLine($"[6/7] 保存到: {savePath}");
+        using var fileStream = new FileStream(savePath, FileMode.Create, FileAccess.Write, FileShare.None);
+        await response.Content.CopyToAsync(fileStream);
+        await fileStream.FlushAsync();
+
+        var fi = new FileInfo(savePath);
+        Console.WriteLine($"[6/7] 文件大小: {fi.Length / 1024}KB");
+
+        // 如果是 zip 文件，检查是否有效
+        if (savePath.EndsWith(".zip", StringComparison.OrdinalIgnoreCase) && fi.Length < 1024)
+        {
+            Console.WriteLine("[6/7] 警告: zip 文件过小，可能是错误页面");
+            var content = await File.ReadAllTextAsync(savePath);
+            Console.WriteLine($"[6/7] 内容前 200 字: {content[..Math.Min(content.Length, 200)]}");
+            File.Delete(savePath);
+            return null;
+        }
+
+        return savePath;
+    }
